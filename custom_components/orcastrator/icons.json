{
  "entity": {
    "sensor": {
      "job": {
        "default": "mdi:printer-3d",
        "state": {
          "idle": "mdi:printer-3d",
          "checking_printer": "mdi:printer-3d-nozzle-outline",
          "powering_on": "mdi:power-plug",
          "waiting_for_printer": "mdi:timer-sand",
          "uploading": "mdi:cloud-upload",
          "print_started": "mdi:printer-3d-nozzle",
          "print_queued": "mdi:tray-full",
          "uploaded": "mdi:check-circle-outline",
          "powering_off": "mdi:power-sleep",
          "cancelled": "mdi:cancel",
          "failed": "mdi:alert-circle"
        }
      }
    },
    "button": {
      "cancel_job": {
        "default": "mdi:cancel"
      }
    },
    "switch": {
      "auto_power_on": {
        "default": "mdi:power-plug",
        "state": {
          "off": "mdi:power-plug-off"
        }
      },
      "auto_power_off": {
        "default": "mdi:power-sleep",
        "state": {
          "off": "mdi:power-off"
        }
      },
      "firmware_restart": {
        "default": "mdi:restart-alert",
        "state": {
          "off": "mdi:restart-off"
        }
      }
    }
  }
}
